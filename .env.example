# Supply your real PostgreSQL URL locally or through your deployment secret manager.
DATABASE_URL=
# Generate a fresh random secret, for example with: openssl rand -hex 32
# Never commit the generated value. There is no fallback signing secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=nodewave-api
JWT_AUDIENCE=nodewave-web
PORT=4000
NODE_ENV=development
# Comma-separated exact origins, no wildcard, path, or trailing slash.
CORS_ORIGIN=http://localhost:3000
# Optional except when explicitly running db:seed. At least 12 characters, at most 72 UTF-8 bytes.
# Existing account passwords are never changed by the seed.
# SEED_PASSWORD=
ALLOW_PRODUCTION_SEED=false
