datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PM
  MEMBER
  CLIENT
}

enum Department {
  PRODUCT
  UIUX
  FRONTEND
  BACKEND
  CLIENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String
  name               String
  avatarUrl          String?
  role               Role
  department         Department
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  createdTasks       Task[]          @relation("TaskCreator")
  assignedTasks      Task[]          @relation("TaskAssignee")
  projectMemberships ProjectMember[]
  clientProjects     Project[]       @relation("ClientProjects")
  auditLogs          AuditLog[]
  attachments        TaskAttachment[]
  comments           Comment[]
  sessions           Session[]

  @@map("users")
}

model Session {
  jti       String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Project {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  clientId    String?
  client      User?           @relation("ClientProjects", fields: [clientId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  members     ProjectMember[]
  tasks       Task[]
  auditLogs   AuditLog[]
  comments    Comment[]

  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  userId     String
  assignedAt DateTime @default(now())
  deletedAt  DateTime?

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id              String           @id @default(uuid())
  taskCode        String
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus       @default(TODO)
  department      Department
  priority        Priority         @default(MEDIUM)
  isClientVisible Boolean          @default(false)
  version         Int              @default(1)
  dueDate         DateTime?
  creatorId       String
  creator         User             @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId      String?
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  dependencies    TaskDependency[] @relation("TaskToPrerequisites")
  dependents      TaskDependency[] @relation("PrerequisiteToTasks")
  attachments     TaskAttachment[]
  comments        Comment[]
  auditLogs       AuditLog[]

  @@unique([projectId, taskCode])
  @@map("tasks")
}

model TaskDependency {
  id                 String   @id @default(uuid())
  taskId             String
  prerequisiteTaskId String
  createdAt          DateTime @default(now())
  deletedAt          DateTime?

  task               Task     @relation("TaskToPrerequisites", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task     @relation("PrerequisiteToTasks", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  // Active-pair uniqueness is enforced by the partial SQL index in 0002_security.
  @@index([taskId, prerequisiteTaskId])
  @@map("task_dependencies")
}

model TaskAttachment {
  id         String    @id @default(uuid())
  taskId     String
  uploaderId String
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id])

  @@map("task_attachments")
}

model Comment {
  id        String    @id @default(uuid())
  taskId    String
  projectId String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@index([projectId])
  @@map("comments")
}

model AuditLog {
  id            String   @id @default(uuid())
  projectId     String
  taskId        String?
  userId        String
  action        String
  changedColumn String?
  oldValue      String?
  newValue      String?
  metadata      Json?
  timestamp     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("audit_logs")
}
